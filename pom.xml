<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 官方父 POM：所有依赖的版本由它统一管理，我们不用自己写版本号 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <!-- 项目身份证：groupId 是组织，artifactId 是项目名 -->
    <groupId>com.example</groupId>
    <artifactId>order-app</artifactId>
    <version>1.0.0</version>

    <properties>
        <java.version>21</java.version>   <!-- Spring Boot 父 POM 认这个属性来决定编译版本 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Web 模块：内嵌 Tomcat + Spring MVC + JSON 序列化，一个依赖全搞定 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Swagger UI：自动扫描 @RestController，生成可视化接口文档页面（零代码） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.17</version>
        </dependency>

        <!-- JDBC 支持：提供 JdbcTemplate（写 SQL 的工具）+ 连接池 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- H2 数据库：纯 Java 内嵌数据库；用于测试，也作为免 Docker 的备用运行方式（h2 profile） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- MySQL 驱动：版本由 Spring Boot 父 POM 统一管理，故无需写 version -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 只取 Spring Security 的加密工具（BCrypt 密码哈希），不引入整个安全框架 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!--
          Actuator：健康检查与运行时观测端点。
          提供 /actuator/health（能否干活）与 liveness / readiness 探针，
          供 Docker HEALTHCHECK、K8s 探针、监控系统使用。
          ★ 默认只暴露 health，env / heapdump 这类敏感端点不会自动打开。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- JWT：api 编译期用；impl / jackson 仅运行期需要 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.7</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.7</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.7</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 测试模块：自带 JUnit 5、AssertJ、MockMvc 等（版本由父 POM 决定） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 提供 mvn spring-boot:run 和"打成可执行 jar"的能力 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 项目里有 2 个 main（控制台版 Main 和 Web 版），必须指明用哪个 -->
                    <mainClass>com.example.order.OrderAppApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>